# Copy to .env.local and replace placeholders (never commit .env.local)
#   cp .env.example .env.local

# Neon Postgres — Console → Project → Connection string (URI)
# https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# Admin panel password (change in production)
ADMIN_PASSWORD=change-me-local-only

# Resend (optional for local; checkout works without real email)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
